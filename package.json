{
  "name": "dsh-pet-prince",
  "version": "0.1.6",
  "description": "深海小王子：DeepSeek Harness 的 2D 透明立绘桌宠插件（whale prince desktop pet for DSH）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "assets/logo.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "anime",
    "whale",
    "cordis",
    "react"
  ],
  "homepage": "https://github.com/qian3194323719-a11y/dsh-pet-prince#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qian3194323719-a11y/dsh-pet-prince.git"
  },
  "bugs": {
    "url": "https://github.com/qian3194323719-a11y/dsh-pet-prince/issues"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/logo.png",
    "assets/pet.json",
    "assets/spritesheet.webp",
    "assets/preview.gif",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "scripts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.1",
    "react": "^18.2.0"
  }
}
